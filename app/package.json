{
  "name": "vela-selfhost",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted charting app built on Vela: authenticated server, market-data bridges, and the workspace UI.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env scripts/dev.mjs",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --env-file-if-exists=../.env dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "create-user": "node --env-file-if-exists=../.env dist/server/cli.js"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.0"
  }
}
