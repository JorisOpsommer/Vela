# Copy to .env and fill in. Never commit .env.

# Finnhub (free tier: 60 req/min) — real-time trade stream, quotes, logos, search
FINNHUB_API_KEY=

# Alpaca (free Basic plan: 200 req/min) — US stock + crypto history, calendar, symbol list
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_TRADING_URL=https://paper-api.alpaca.markets/v2

# Session and encryption secret, 32+ characters: `openssl rand -hex 32`
SESSION_SECRET=


# First-start admin account (used only while no users exist). Leave empty to get a
# one-time password printed in `docker compose logs app` instead.
ADMIN_USERNAME=
ADMIN_PASSWORD=


# Optional
# SESSION_TTL_DAYS=14
# LOG_LEVEL=info

# Reverse proxy / network (see README-selfhost.md)
# COOKIE_SECURE=true          # false only for plain-HTTP access on your LAN
# APP_PORT=8080               # host port to publish
